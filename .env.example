API_KEY=<OPTIONAL>
CHANNEL_ID=<OPTIONAL>

# X (Twitter) — OAuth 1.0a user context, from developer.x.com portal
# App permission must be "Read and write"; the account needs X Premium to publish Articles.
X_API_KEY=<OPTIONAL>
X_API_SECRET=<OPTIONAL>
X_ACCESS_TOKEN=<OPTIONAL>
X_ACCESS_TOKEN_SECRET=<OPTIONAL>

# Canonical blog origin used for the CTA links (no trailing slash)
SITE_URL=<OPTIONAL>

# Hero image generation. OpenAI is the default provider (scripts/generate-hero-image.mjs).
# ~$0.05-0.06/image (gpt-image-1.5, medium quality) at time of writing.
OPENAI_API_KEY=<OPTIONAL>

# Gemini fallback (--provider gemini). Needs prepay credits on the billing
# page (aistudio.google.com), not just a linked card.
GEMINI_API_KEY=<OPTIONAL>