---
import { type CollectionEntry } from 'astro:content';

import BlogPost from '@layouts/BlogPost.astro';
import Code from '@components/mdx/Code.astro';
import { getSinglePage } from '@utils/getAllTags';

export async function getStaticPaths() {
  const posts = (await getSinglePage('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  const weekly = posts.filter((p) => p.data.series === 'weekly-log');
  const link = (p: (typeof posts)[number] | undefined) => (p ? { slug: p.slug, title: p.data.title } : null);
  return posts.map((post) => {
    const seriesIndex = weekly.findIndex((p) => p.slug === post.slug);
    const candidates = posts
      .filter((p) => p.slug !== post.slug)
      .map((p) => ({
        post: p,
        score: p.data.tags.filter((tag) => tag !== 'others' && post.data.tags.includes(tag)).length,
      }))
      .filter((p) => p.score > 0)
      .sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf());
    return {
      params: { slug: post.slug },
      props: {
        post,
        relatedPost: link(candidates[0]?.post),
        firstPost: seriesIndex >= 0 && weekly.at(-1)?.slug !== post.slug ? link(weekly.at(-1)) : null,
        prevPost: seriesIndex >= 0 ? link(weekly[seriesIndex + 1]) : null,
        nextPost: seriesIndex >= 0 ? link(weekly[seriesIndex - 1]) : null,
      },
    };
  });
}

type PostLink = { slug: string; title: string } | null;
type Props = {
  post: CollectionEntry<'blog'>;
  relatedPost: PostLink;
  firstPost: PostLink;
  prevPost: PostLink;
  nextPost: PostLink;
};

const { post, prevPost, nextPost, firstPost, relatedPost } = Astro.props;
const { Content } = await post.render();
---

<BlogPost
  {...post.data}
  slug={post.slug}
  body={post.body}
  prevPost={prevPost}
  nextPost={nextPost}
  firstPost={firstPost}
  relatedPost={relatedPost}
>
  <Content components={{ pre: Code }} />
</BlogPost>
