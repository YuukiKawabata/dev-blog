---
import { type CollectionEntry, getCollection } from "astro:content";

import BlogPost from "@layouts/BlogPost.astro";
import Code from "@components/mdx/Code.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  return posts.map((post, index) => {
    // posts は新しい順。prev = ひとつ古い記事、next = ひとつ新しい記事。
    const prev = posts[index + 1];
    const next = posts[index - 1];
    return {
      params: { slug: post.slug },
      props: {
        post,
        prevPost: prev ? { slug: prev.slug, title: prev.data.title } : null,
        nextPost: next ? { slug: next.slug, title: next.data.title } : null,
      },
    };
  });
}

type PostLink = { slug: string; title: string } | null;
type Props = {
  post: CollectionEntry<"blog">;
  prevPost: PostLink;
  nextPost: PostLink;
};

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await post.render();
---

<BlogPost {...post.data} slug={post.slug} body={post.body} prevPost={prevPost} nextPost={nextPost}>
  <Content components={{ pre: Code }} />
</BlogPost>
