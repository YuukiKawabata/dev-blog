---
import Base from '@layouts/Base.astro';
import { apps, developerPage, otherAppNames, publishedAppCount } from '@config/apps';
---

<Base
  meta_title="アプリ"
  description={`河畑祐輝が個人で作って公開しているアプリ。App Storeに${publishedAppCount}本出しています。`}
>
  <h1 class="page-title">アプリ</h1>
  <p class="mt-4 leading-[1.9] text-gray-600 dark:text-gray-400">
    {publishedAppCount}本出して、知名度はこれから。最近いちばん手を入れた{apps.length}本です。
  </p>

  <div class="mt-12 space-y-12">
    {
      apps.map((app) => (
        <article class="flex gap-5">
          <img
            src={app.icon}
            alt=""
            width={56}
            height={56}
            loading="lazy"
            decoding="async"
            class="h-14 w-14 shrink-0 rounded-[15px] shadow-sm ring-1 ring-black/5 dark:ring-white/10"
          />
          <div>
            <h2 class="text-xl">{app.name}</h2>
            {app.badge && <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{app.badge}</p>}
            <p class="mt-3 leading-[1.85] text-gray-600 dark:text-gray-400">{app.description}</p>
            <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
              {app.stores.map((store) => (
                <a
                  href={store.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-track={`app:${app.name}:${store.label}`}
                  class="text-link"
                >
                  {store.label} ↗
                </a>
              ))}
              {app.story && (
                <a href={app.story.url} class="text-link">
                  {app.story.label} →
                </a>
              )}
            </p>
          </div>
        </article>
      ))
    }
  </div>

  <section class="mt-16 border-t border-gray-200 pt-8 dark:border-gray-800" aria-labelledby="others-heading">
    <h2 id="others-heading" class="section-label">ほかの{otherAppNames.length}本と、Webの実験</h2>
    <p class="mt-3 leading-[1.9] text-gray-600 dark:text-gray-400">{otherAppNames.join(' / ')}</p>
    <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm">
      <a
        href={developerPage}
        target="_blank"
        rel="noopener noreferrer"
        data-track="app:developer-page"
        class="text-link">App Store の一覧 ↗</a
      >
      <a
        href="https://lucky-spin-jp.pages.dev/home"
        target="_blank"
        rel="noopener noreferrer"
        data-track="web:lucky-play"
        class="text-link">LUCKY PLAY ↗</a
      >
    </p>
  </section>
</Base>
