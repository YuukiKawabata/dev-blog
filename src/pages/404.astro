---
import Base from "@layouts/Base.astro";
---

<Base meta_title="404 Not Found" noindex>
  <section class="flex min-h-[50vh] flex-col justify-center">
    <p class="text-sm text-gray-400 dark:text-gray-500">404</p>
    <h1 class="page-title mt-3">ページが見つかりませんでした</h1>
    <p class="mt-4 leading-[1.9] text-gray-600 dark:text-gray-400">
      URLが変更されたか、削除された可能性があります。
    </p>
    <p class="mt-6 flex gap-4 text-sm">
      <a href="/" class="text-link">ホーム →</a>
      <a href="/blog/" class="text-link">記事一覧 →</a>
    </p>
  </section>
</Base>
