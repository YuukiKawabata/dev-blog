---
import Base from "@layouts/Base.astro";
import { getTaxonomy } from "@utils/getAllTags";

const tags = await getTaxonomy("blog", "tags");
---

<Base meta_title="タグ">
  <section>
    <p class="font-mono text-xs font-medium uppercase tracking-[0.25em] text-accent-700 dark:text-accent-400">Tags</p>
    <h1 class="mt-3 font-heading text-3xl font-semibold sm:text-4xl">タグ</h1>
    <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">技術名や関心テーマから記事を探せます。</p>

    <ul class="mt-10 flex flex-wrap gap-x-5 gap-y-3">
      {
        tags.map((tag) => (
          <li>
            <a
              class="text-base text-gray-600 underline decoration-gray-300 decoration-1 underline-offset-4 transition-colors hover:text-accent-700 hover:decoration-accent-400 dark:text-gray-400 dark:decoration-gray-600 dark:hover:text-accent-400"
              href={`/tags/${tag.slug}`}
              title={`${tag.name}タグの記事を見る`}
            >
              {tag.name}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
