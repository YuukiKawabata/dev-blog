---
import Base from "@layouts/Base.astro";
import PostList from "@components/PostList.astro";
import { getTaxonomy, getSinglePage, taxonomyFilter } from "@utils/getAllTags";
import { deslugify } from "@utils/slug";

export async function getStaticPaths() {
  const categories = await getTaxonomy("blog", "categories");

  return categories.map((category) => {
    return {
      params: { category: category.slug },
    };
  });
}

const { category } = Astro.params;

const posts = (await getSinglePage("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const filterByCategory = taxonomyFilter(posts, "categories", category);
---

<Base meta_title={`カテゴリ: ${deslugify(category)}`}>
  <h1 class="page-title capitalize">{deslugify(category)}</h1>
  <div class="mt-10">
    <PostList posts={filterByCategory} groupByYear />
  </div>
</Base>
