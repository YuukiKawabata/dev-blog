---
import Base from '@layouts/Base.astro';
import { getSinglePage } from '@utils/getAllTags';
const posts = await getSinglePage('blog');
const picks = [
  {
    slug: '20260816-tri-fold-phone-personal-take',
    label: 'どんな人？',
    reason: '新しい技術に惹かれても、自分の暮らしで使うかは別。道具を選ぶときの考え方を書きました。',
  },
  {
    slug: '20261015-phone-first-setup',
    label: '試して分かったこと',
    reason: '発信と開発をスマホから頼めるようにした手順と、まだMacが必要なところ。できることと限界をまとめました。',
  },
  {
    slug: '20261011-aso-four-apps-two-grew',
    label: '作ったあとの話',
    reason: '公開したアプリの見せ方を変え、実際の数字を振り返りました。伸びたものも、動かなかったものも。',
  },
].map((pick) => {
  const post = posts.find((post) => post.slug === pick.slug);
  if (!post) throw new Error(`おすすめ記事が見つかりません: ${pick.slug}`);
  return { ...pick, post };
});
---

<Base meta_title="初めての方へ" description="Yukiの考え方、試したこと、個人開発の活動が分かる3本の記事。">
  <h1 class="page-title">初めての方へ</h1>
  <p class="mt-6 leading-relaxed">
    こんにちは、Yukiです。Webとアプリを作りながら、気になったものを試して書いています。まずは、違う角度から選んだ3本をどうぞ。
  </p>
  <ol class="mt-10 space-y-10">
    {
      picks.map(({ post, label, reason }) => (
        <li>
          <p class="section-label">{label}</p>
          <h2 class="mt-3 text-xl font-bold">
            <a class="text-link" href={`/blog/${post.slug}/`} data-track={`reading:${post.slug}:start`}>
              {post.data.title}
            </a>
          </h2>
          <p class="mt-3 leading-relaxed">{reason}</p>
        </li>
      ))
    }
  </ol>
  <nav class="mt-12 flex flex-wrap gap-6 border-t border-gray-200 pt-6 dark:border-gray-800" aria-label="もっと知る">
    <a class="text-link" href="/about/">プロフィール →</a>
    <a class="text-link" href="/weekly/">Weekly Logで続きを読む →</a>
  </nav>
</Base>
