---
import { apps, developerPage, otherAppNames, publishedAppCount } from '@config/apps';
---

<section
  id="apps"
  class="scroll-mt-24 border-t border-gray-200 pt-16 first:border-t-0 first:pt-0 dark:border-gray-800"
  aria-labelledby="apps-heading"
>
  <div class="max-w-2xl">
    <p class="font-mono text-xs font-medium uppercase tracking-[0.22em] text-accent-700 dark:text-accent-400">
      Selected Apps
    </p>
    <h2 id="apps-heading" class="jp-phrase mt-4 text-3xl leading-tight sm:text-4xl">
      作ったもの。<br class="sm:hidden" />知名度はこれから。
    </h2>
    <p class="mt-5 text-sm leading-[1.9] text-gray-500 sm:text-base dark:text-gray-400">
      {publishedAppCount}本出して、最近いちばん手を入れた{apps.length}本をここに置いています。残りはApp
      Storeの一覧からどうぞ。
    </p>
  </div>

  <div class="mt-10 grid gap-4 sm:grid-cols-2">
    {
      apps.map((app) => (
        <article
          class:list={[
            'group flex flex-col rounded-2xl border bg-white/55 p-5 transition-colors dark:bg-gray-900/40',
            app.lead
              ? 'border-accent-200 sm:col-span-2 sm:p-7 dark:border-accent-900'
              : 'min-h-[218px] border-gray-200 hover:border-gray-300 dark:border-gray-800 dark:hover:border-gray-700',
          ]}
        >
          <div class:list={['flex gap-4', app.lead ? 'items-center sm:gap-5' : 'items-start']}>
            <img
              src={app.icon}
              alt=""
              width={app.lead ? 64 : 48}
              height={app.lead ? 64 : 48}
              loading="lazy"
              decoding="async"
              class:list={[
                'object-cover shadow-sm ring-1 ring-black/5 dark:ring-white/10',
                app.lead ? 'h-16 w-16 rounded-[17px]' : 'h-12 w-12 rounded-[13px]',
              ]}
            />
            {app.lead && (
              <div>
                {app.badge && (
                  <p class="text-[11px] font-semibold tracking-wide text-accent-700 dark:text-accent-400">
                    {app.badge}
                  </p>
                )}
                <h3 class="mt-1 text-2xl">{app.name}</h3>
              </div>
            )}
          </div>
          {!app.lead && <h3 class="mt-4 text-xl">{app.name}</h3>}
          <p
            class:list={[
              'mt-2 flex-1 text-sm leading-[1.75] text-gray-500 dark:text-gray-400',
              app.lead && 'mt-4 max-w-xl sm:text-base',
            ]}
          >
            {app.description}
          </p>
          <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2">
            {app.stores.map((store) => (
              <a
                href={store.url}
                target="_blank"
                rel="noopener noreferrer"
                data-track={`app:${app.name}:${store.label}`}
                class="inline-flex min-h-10 items-center gap-1.5 text-xs font-semibold text-gray-800 underline decoration-gray-300 underline-offset-4 transition-colors hover:text-accent-700 dark:text-gray-200 dark:decoration-gray-600 dark:hover:text-accent-400"
              >
                {store.label}
                <span aria-hidden="true">↗</span>
              </a>
            ))}
            {app.story && (
              <a
                href={app.story.url}
                class="inline-flex min-h-10 items-center gap-1.5 text-xs font-semibold text-accent-700 underline decoration-accent-200 underline-offset-4 hover:decoration-accent-500 dark:text-accent-400 dark:decoration-accent-900"
              >
                {app.story.label}
                <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>

  <div
    class="mt-5 flex flex-col gap-4 rounded-2xl border border-dashed border-gray-300 px-5 py-5 sm:flex-row sm:items-center sm:justify-between dark:border-gray-700"
  >
    <div>
      <p class="text-sm font-semibold text-gray-900 dark:text-white">ほかの{otherAppNames.length}本と、Webの実験。</p>
      <p class="mt-1 text-xs leading-relaxed text-gray-500 dark:text-gray-400">
        {otherAppNames.join(' / ')}
      </p>
    </div>
    <div class="flex shrink-0 flex-wrap gap-x-4 gap-y-2 text-xs font-semibold">
      <a
        href={developerPage}
        target="_blank"
        rel="noopener noreferrer"
        data-track="app:developer-page"
        class="text-accent-700 hover:underline dark:text-accent-400">App Store一覧 ↗</a
      >
      <a
        href="https://lucky-spin-jp.pages.dev/home"
        target="_blank"
        rel="noopener noreferrer"
        data-track="web:lucky-play"
        class="text-gray-600 hover:underline dark:text-gray-300">LUCKY PLAY ↗</a
      >
    </div>
  </div>
</section>
