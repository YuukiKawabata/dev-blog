---
import { apps } from '@config/apps';

const developerPage = 'https://apps.apple.com/jp/developer/yuuki-kawabata/id1865457350';
---

<section
  id="apps"
  class="scroll-mt-24 border-t border-gray-200 pt-16 dark:border-gray-800"
  aria-labelledby="apps-heading"
>
  <div class="max-w-2xl">
    <p class="font-mono text-xs font-medium uppercase tracking-[0.22em] text-accent-700 dark:text-accent-400">
      Selected Apps
    </p>
    <h2 id="apps-heading" class="jp-phrase mt-4 text-3xl leading-tight sm:text-4xl">
      作ったもの。<br class="sm:hidden" />知名度はこれから。
    </h2>
    <p class="mt-5 text-sm leading-[1.9] text-gray-500 sm:text-base dark:text-gray-400">
      売れた順ではありません。全部まとめても珈琲代以下なので、安心して好きなものからどうぞ。
    </p>
  </div>

  <div class="mt-10 grid gap-4 sm:grid-cols-2">
    {
      apps.map((app, index) => (
        <article class="group flex min-h-[218px] flex-col rounded-2xl border border-gray-200 bg-white/55 p-5 transition-colors hover:border-gray-300 dark:border-gray-800 dark:bg-gray-900/40 dark:hover:border-gray-700">
          <div class="flex items-start justify-between gap-4">
            <img
              src={app.icon}
              alt=""
              width="48"
              height="48"
              loading="lazy"
              decoding="async"
              class="h-12 w-12 rounded-[13px] object-cover shadow-sm ring-1 ring-black/5 dark:ring-white/10"
            />
            <span class="font-mono text-[11px] tabular-nums text-gray-300 dark:text-gray-700">
              {String(index + 1).padStart(2, '0')}
            </span>
          </div>
          <h3 class="mt-4 text-xl">{app.name}</h3>
          <p class="mt-2 flex-1 text-sm leading-[1.75] text-gray-500 dark:text-gray-400">{app.description}</p>
          <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2">
            {app.stores.map((store) => (
              <a
                href={store.url}
                target="_blank"
                rel="noopener noreferrer"
                data-track={`app:${app.name}:${store.label}`}
                class="inline-flex min-h-10 items-center gap-1.5 text-xs font-semibold text-gray-800 underline decoration-gray-300 underline-offset-4 transition-colors hover:text-accent-700 dark:text-gray-200 dark:decoration-gray-600 dark:hover:text-accent-400"
              >
                {store.label}
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </article>
      ))
    }
  </div>

  <div
    class="mt-5 flex flex-col gap-4 rounded-2xl border border-dashed border-gray-300 px-5 py-5 sm:flex-row sm:items-center sm:justify-between dark:border-gray-700"
  >
    <div>
      <p class="text-sm font-semibold text-gray-900 dark:text-white">Webでも、いろいろ実験中。</p>
      <p class="mt-1 text-xs leading-relaxed text-gray-500 dark:text-gray-400">Kizashi / LUCKY PLAY</p>
    </div>
    <div class="flex flex-wrap gap-x-4 gap-y-2 text-xs font-semibold">
      <a
        href="https://kizashi-inky.vercel.app/"
        target="_blank"
        rel="noopener noreferrer"
        data-track="web:kizashi"
        class="text-accent-700 hover:underline dark:text-accent-400">Kizashiを見る ↗</a
      >
      <a
        href="https://lucky-spin-jp.pages.dev/home"
        target="_blank"
        rel="noopener noreferrer"
        data-track="web:lucky-play"
        class="text-accent-700 hover:underline dark:text-accent-400">LUCKY PLAYを見る ↗</a
      >
      <a
        href={developerPage}
        target="_blank"
        rel="noopener noreferrer"
        data-track="app:developer-page"
        class="text-gray-600 hover:underline dark:text-gray-300">App Store一覧 ↗</a
      >
    </div>
  </div>
</section>
