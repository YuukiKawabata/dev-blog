---
import { Image } from 'astro:assets';
import config from '@config/config.json';
import social from '@config/social';

const socialItems = social.networks;

// Display lines — each rises in sequence; the vermilion period pops after landing.
const words = ['Build', 'Ship', 'Learn'];
const lineDelay = (i: number) => 0.15 + i * 0.12;
const periodDelay = (i: number) => lineDelay(i) + 0.55;
---

<section class="border-b border-gray-200 dark:border-gray-800">
  <div class="mx-auto max-w-3xl px-6 pb-16 pt-16 sm:pb-20 sm:pt-24 lg:px-8">
    <p
      class="fade-up font-mono text-xs font-medium uppercase tracking-[0.25em] text-accent-700 dark:text-accent-400"
      style="--d: 0.05s"
    >
      Yuki Kawabata — Dev Log
    </p>

    <h1
      class="mt-8 font-heading text-[clamp(4.25rem,19vw,7rem)] font-semibold leading-[1.04] tracking-[-0.015em] text-gray-950 dark:text-white"
    >
      {
        words.map((word, i) => (
          <span class="line-mask">
            <span class="line-rise" style={`--d: ${lineDelay(i)}s`}>
              {word}<span
                class="period-pop text-accent-600 dark:text-accent-500"
                style={`--d: ${periodDelay(i)}s`}
              >.</span>
            </span>
          </span>
        ))
      }
    </h1>

    <p
      class="fade-up jp-phrase mt-10 max-w-xl text-base leading-[1.95] text-gray-600 dark:text-gray-300 sm:text-lg"
      style="--d: 0.8s"
    >
      AIとともに、個人開発の全過程を記録する。企画・実装・ストア公開・運用、その失敗まで。
    </p>

    <div
      class="fade-up mt-12 flex flex-wrap items-center justify-between gap-x-6 gap-y-5"
      style="--d: 0.95s"
    >
      <a href="/about/" class="group flex items-center gap-3.5" aria-label="プロフィール">
        <Image
          src={config.author.avatar}
          alt={config.author.name}
          width={80}
          height={80}
          decoding="async"
          loading="eager"
          class="h-11 w-11 rounded-full border border-gray-200 object-cover dark:border-gray-800"
        />
        <span class="text-sm">
          <span class="block font-semibold text-gray-900 transition-colors group-hover:text-accent-700 dark:text-white dark:group-hover:text-accent-400">
            {config.author.name}
          </span>
          <span class="mt-0.5 block text-xs text-gray-500 dark:text-gray-400">
            プロダクトエンジニア — Web / モバイル / AI
          </span>
        </span>
      </a>

      <div class="flex items-center gap-5">
        {
          socialItems?.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-400 transition-colors hover:text-accent-700 dark:text-gray-500 dark:hover:text-accent-400"
            >
              <span class="sr-only">{item.name}</span>
              <div class="h-5 w-5">
                <Fragment set:html={item.svg} />
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
