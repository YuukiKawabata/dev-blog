---
import menu from '@config/menu.json';
import config from '@config/config.json';
import ThemeIcon from '@components/ThemeIcon.astro';
import BrandMark from '@components/BrandMark.astro';

const { main }: { main: { name: string; url: string }[] } = menu;
---

<header
  transition:persist="site-header"
  class="sticky top-0 z-50 w-full border-b border-gray-200/60 bg-paper/85 backdrop-blur-md transition-colors duration-300 dark:border-gray-800/60 dark:bg-gray-950/85"
>
  <div class="mx-auto flex max-w-2xl items-center justify-between gap-4 px-5 py-4 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="ホーム">
      <BrandMark size={22} class="text-gray-950 dark:text-white" />
      <span class="text-[15px] font-semibold tracking-tight text-gray-950 dark:text-white">
        {config.site.brand}
      </span>
    </a>

    <div class="flex items-center gap-4 sm:gap-6">
      <nav class="flex items-center gap-4 sm:gap-6" aria-label="メインナビゲーション">
        {
          main.map((item) => (
            <a href={item.url} class="nav-link">
              {item.name}
            </a>
          ))
        }
      </nav>
      {config.features.dark_mode && <ThemeIcon />}
    </div>
  </div>
</header>
