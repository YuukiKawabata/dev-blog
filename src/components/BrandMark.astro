---
// 右上が欠けた正方形と、そこに置いたオレンジの小さな正方形。X ヘッダーのマークと同じ形。
interface Props {
  size?: number;
  class?: string;
}

const { size = 24, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  class:list={['shrink-0', className]}
>
  <path d="M20 6H5v21h21V12" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" />
  <rect x="23" y="3" width="6" height="6" class="fill-accent-500" />
</svg>
