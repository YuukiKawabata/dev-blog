---
import config from "@config/config.json";
const year = new Date().getFullYear();
---

<footer class="mx-auto mt-20 max-w-4xl px-5 pb-12 sm:px-6 lg:px-8">
  <div class="flex flex-col gap-3 border-t border-gray-200 pt-8 sm:flex-row sm:items-center sm:justify-between dark:border-gray-800">
    <p class="text-xs text-gray-500 dark:text-gray-500">
      &copy; {year} {config.site.brand}
    </p>
    <p class="text-xs font-medium text-gray-500 dark:text-gray-500">
      作って、届けて、改善する。
    </p>
  </div>
</footer>
