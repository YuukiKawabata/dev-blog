---
import config from '@config/config.json';
import social from '@config/social';

const year = new Date().getFullYear();
---

<footer class="mx-auto mt-24 max-w-2xl px-5 pb-12 sm:px-6">
  <div
    class="flex flex-col gap-3 border-t border-gray-200 pt-8 text-sm text-gray-400 sm:flex-row sm:items-center sm:justify-between dark:border-gray-800 dark:text-gray-500"
  >
    <p>&copy; {year} {config.site.brand}</p>
    <ul class="flex flex-wrap gap-x-4 gap-y-1">
      {
        social.networks.map((item) => (
          <li>
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              data-track={`social:${item.name}:footer`}
              class="transition-colors hover:text-gray-900 dark:hover:text-white"
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/rss.xml" class="transition-colors hover:text-gray-900 dark:hover:text-white">RSS</a>
      </li>
    </ul>
  </div>
</footer>
