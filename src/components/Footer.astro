---
import config from '@config/config.json';
import menu from '@config/menu.json';
import social from '@config/social';

const year = new Date().getFullYear();
const socialItems = social.networks.map((item) => ({
  ...item,
  label: item.label ?? item.name,
}));
---

<footer class="mx-auto mt-24 max-w-3xl px-6 pb-12 lg:px-8">
  <div class="border-t border-gray-200 pt-10 dark:border-gray-800">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="font-heading text-lg font-semibold text-gray-900 dark:text-white">
          {config.site.brand}
        </p>
        <p class="mt-2 font-heading text-sm font-semibold tracking-wide text-gray-500 dark:text-gray-400">
          元店長<span class="text-accent-600 dark:text-accent-500"> →</span>
           エンジニア<span class="text-accent-600 dark:text-accent-500"> →</span>
           アプリ9本
        </p>
      </div>

      <div class="flex gap-14">
        <nav aria-label="フッターナビゲーション">
          <ul class="space-y-2.5">
            {
              menu.main?.map((item) => (
                <li>
                  <a
                    href={item.url}
                    class="text-sm text-gray-500 transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
                  >
                    {item.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <ul class="space-y-2.5">
          {
            socialItems?.map((item) => (
              <li>
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-track={`social:${item.name}:footer`}
                  class="text-sm text-gray-500 transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="/rss.xml"
              class="text-sm text-gray-500 transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
            >
              RSS
            </a>
          </li>
        </ul>
      </div>
    </div>

    <p class="mt-12 font-mono text-xs text-gray-400 dark:text-gray-600">
      &copy; {year}
      {config.site.brand}
    </p>
  </div>
</footer>
