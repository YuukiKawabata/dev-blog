---
import Base from "@layouts/Base.astro";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";
import { Image } from "astro:assets";
import config from "@config/config.json";
import social from "@config/social";
import { slugify } from "@utils/slug";
import { postTitleTransition } from "@utils/transitionName";

type PostLink = { slug: string; title: string } | null;

type Props = CollectionEntry<"blog">["data"] & {
  slug: string;
  body?: string;
  prevPost?: PostLink;
  nextPost?: PostLink;
};

const { title, description, pubDate, updatedDate, heroImage, tags, slug, body, prevPost, nextPost } = Astro.props;

// 日本語は平均 500〜600字/分。コード・記号込みでゆるめに見積もる。
const readingMinutes = body ? Math.max(1, Math.round(body.length / 550)) : null;

const xProfile = social.networks.find((n) => n.name === "x");
---

<Base
  meta_title={title}
  description={description}
  image={heroImage}
  pubDate={pubDate}
  updatedDate={updatedDate}
  blogpost
>
  <div class="reading-progress" aria-hidden="true"></div>

  <article>
    <header class="mb-10">
      <p class="text-sm text-gray-400 dark:text-gray-500">
        <FormattedDate date={pubDate} />
        {readingMinutes && <span> · 約{readingMinutes}分</span>}
      </p>
      <h1 transition:name={postTitleTransition(slug)} class="page-title mt-3">
        {title}
      </h1>
    </header>

    {
      heroImage && (
        <figure class="mb-10 overflow-hidden rounded-md">
          <Image
            class="h-full w-full object-cover"
            src={heroImage}
            alt={title}
            width={960}
            height={480}
            decoding="async"
            loading="eager"
          />
        </figure>
      )
    }

    <div class="prose prose-lg prose-neutral dark:prose-invert">
      <slot />
    </div>

    {
      tags?.length > 0 && (
        <p class="mt-12 flex flex-wrap gap-x-4 gap-y-1 text-sm">
          {tags.map((tag) => (
            <a
              href={`/tags/${slugify(tag)}`}
              class="text-gray-500 transition-colors hover:text-accent-700 dark:text-gray-400 dark:hover:text-accent-400"
            >
              #{tag}
            </a>
          ))}
        </p>
      )
    }

    <aside class="mt-12 flex items-start gap-4 border-t border-gray-200 pt-8 dark:border-gray-800" aria-label="書いた人">
      <Image
        alt=""
        class="h-10 w-10 shrink-0 rounded-full"
        width={80}
        height={80}
        src={config.author.avatar}
        decoding="async"
        loading="lazy"
      />
      <div class="text-sm leading-[1.85]">
        <p>
          <a href="/about/" class="font-medium text-gray-900 hover:text-accent-700 dark:text-white dark:hover:text-accent-400">
            {config.site.brand}
          </a>
        </p>
        <p class="mt-1 text-gray-500 dark:text-gray-400">{config.author.bio}</p>
        {
          xProfile && (
            <a
              href={xProfile.url}
              target="_blank"
              rel="noopener noreferrer"
              data-track="social:x:post"
              class="text-link mt-2 inline-block"
            >
              Xで続きを見る ↗
            </a>
          )
        }
      </div>
    </aside>

    {
      (prevPost || nextPost) && (
        <nav class="mt-10 space-y-3 text-sm" aria-label="前後の記事">
          {nextPost && (
            <a href={`/blog/${nextPost.slug}/`} class="group flex gap-3">
              <span class="shrink-0 text-gray-400 dark:text-gray-500">次</span>
              <span class="jp-phrase text-gray-700 transition-colors group-hover:text-accent-700 dark:text-gray-300 dark:group-hover:text-accent-400">
                {nextPost.title}
              </span>
            </a>
          )}
          {prevPost && (
            <a href={`/blog/${prevPost.slug}/`} class="group flex gap-3">
              <span class="shrink-0 text-gray-400 dark:text-gray-500">前</span>
              <span class="jp-phrase text-gray-700 transition-colors group-hover:text-accent-700 dark:text-gray-300 dark:group-hover:text-accent-400">
                {prevPost.title}
              </span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</Base>
