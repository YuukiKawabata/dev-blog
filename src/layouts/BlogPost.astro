---
import Base from "@layouts/Base.astro";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";
import { Image } from "astro:assets";
import config from "@config/config.json";
import { slugify } from "@utils/slug";
import { postTitleTransition } from "@utils/transitionName";

type PostLink = { slug: string; title: string } | null;

type Props = CollectionEntry<"blog">["data"] & {
  slug: string;
  body?: string;
  prevPost?: PostLink;
  nextPost?: PostLink;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  categories,
  tags,
  slug,
  body,
  prevPost,
  nextPost,
} = Astro.props;

// 日本語は平均 500〜600字/分。コード・記号込みでゆるめに見積もる。
const readingMinutes = body ? Math.max(1, Math.round(body.length / 550)) : null;
---

<Base
  meta_title={title}
  description={description}
  image={heroImage}
  pubDate={pubDate}
  updatedDate={updatedDate}
  blogpost
>
  <div class="reading-progress" aria-hidden="true"></div>

  <article>
    <header class="mb-12">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 font-mono text-xs text-gray-500 dark:text-gray-400">
        {
          categories?.slice(0, 1).map((category) => (
            <a
              href={`/categories/${slugify(category)}`}
              class="font-medium uppercase tracking-[0.15em] text-accent-700 transition-colors hover:text-accent-800 dark:text-accent-400 dark:hover:text-accent-300"
            >
              {category}
            </a>
          ))
        }
        <span class="text-gray-300 dark:text-gray-700">/</span>
        <FormattedDate date={pubDate} />
        {readingMinutes && (
          <>
            <span class="text-gray-300 dark:text-gray-700">/</span>
            <span>約{readingMinutes}分</span>
          </>
        )}
      </div>

      <h1
        transition:name={postTitleTransition(slug)}
        class="jp-phrase mt-6 font-heading text-3xl font-semibold leading-[1.3] text-gray-950 dark:text-white sm:text-4xl sm:leading-[1.25] md:text-[2.75rem]"
      >
        {title}
      </h1>

      <div class="mt-8 flex items-center gap-2.5 border-t border-gray-200 pt-6 text-sm text-gray-500 dark:border-gray-800 dark:text-gray-400">
        <Image
          alt={config.author.name}
          class="h-7 w-7 rounded-full"
          width={50}
          height={50}
          src={config.author.avatar}
          decoding="async"
          loading="lazy"
        />
        <span class="font-medium text-gray-700 dark:text-gray-300">{config.author.name}</span>
      </div>
    </header>

    {
      heroImage && (
        <figure class="mb-12 overflow-hidden rounded-lg border border-gray-200 dark:border-gray-800">
          <Image
            class="h-full w-full object-cover"
            src={heroImage}
            alt={title}
            width={960}
            height={480}
            decoding="async"
            loading="lazy"
          />
        </figure>
      )
    }

    <div class="prose prose-lg prose-neutral dark:prose-invert">
      <slot />
    </div>

    {tags?.length > 0 && (
      <div class="mt-14 flex flex-wrap gap-x-4 gap-y-2">
        {tags.map((tag) => (
          <a
            href={`/tags/${slugify(tag)}`}
            class="text-sm text-gray-500 transition-colors hover:text-accent-700 dark:text-gray-400 dark:hover:text-accent-400"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}

    {(prevPost || nextPost) && (
      <nav
        class:list={[
          "mt-12 grid gap-px overflow-hidden rounded-lg border border-gray-200 bg-gray-200 dark:border-gray-800 dark:bg-gray-800",
          prevPost && nextPost && "sm:grid-cols-2",
        ]}
        aria-label="前後の記事"
      >
        {prevPost && (
          <div class="bg-paper dark:bg-gray-950">
            <a href={`/blog/${prevPost.slug}/`} class="group block h-full p-5">
              <span class="font-mono text-xs uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">
                ← 前の記事
              </span>
              <span class="jp-phrase mt-2 block font-heading text-sm font-semibold leading-snug text-gray-900 transition-colors group-hover:text-accent-700 dark:text-white dark:group-hover:text-accent-400">
                {prevPost.title}
              </span>
            </a>
          </div>
        )}
        {nextPost && (
          <div class="bg-paper text-right dark:bg-gray-950">
            <a href={`/blog/${nextPost.slug}/`} class="group block h-full p-5">
              <span class="font-mono text-xs uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500">
                次の記事 →
              </span>
              <span class="jp-phrase mt-2 block font-heading text-sm font-semibold leading-snug text-gray-900 transition-colors group-hover:text-accent-700 dark:text-white dark:group-hover:text-accent-400">
                {nextPost.title}
              </span>
            </a>
          </div>
        )}
      </nav>
    )}
  </article>
</Base>
