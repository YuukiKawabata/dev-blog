---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Analytics from '@components/Analytics.astro';
import config from '@config/config.json';
import social from '@config/social';

import '@styles/global.css';

// Font imports — Inter (Latin) + Noto Sans JP (Japanese)
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/noto-sans-jp/400.css';
import '@fontsource/noto-sans-jp/500.css';
import '@fontsource/noto-sans-jp/700.css';
import '@fontsource/noto-sans-jp/900.css';

import { ViewTransitions } from 'astro:transitions';

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  blogpost?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  slug?: string;
  tags?: string[];
}

const { title, meta_title, description, noindex, blogpost, image, pubDate, updatedDate, slug, tags } = Astro.props;

// 分析用のページ分類。GA4 の content_group に入る。
const contentGroup = (() => {
  if (blogpost) return 'article';
  const [first] = Astro.url.pathname.split('/').filter(Boolean);
  return first ?? 'top';
})();

const siteRoot = config.site.base_url.replace(/\/$/, '');
const toAbsolute = (path: string) => (path.startsWith('http') ? path : `${siteRoot}/${path.replace(/^\//, '')}`);

// Page <title>: subpages get "<page> | <brand>"; home uses the full SEO title.
const pageLabel = meta_title || title;
const pageTitle = pageLabel ? `${pageLabel} | ${config.site.brand}` : config.site.title;
const pageDescription = description || config.metadata.meta_description;

const canonicalURL = new URL(Astro.url.pathname, config.site.base_url).href;

// OG image: explicit image → default site OG image fallback (never a broken URL).
const ogImage = toAbsolute(image || config.site.ogImage);

// Social profile URLs for structured-data sameAs.
const sameAs = social.networks.map((n) => n.url).filter(Boolean);

const person = {
  '@type': 'Person',
  name: config.author.name,
  alternateName: config.author.alternateName,
  url: config.site.base_url,
  image: toAbsolute(config.author.avatar),
  sameAs,
};

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: config.site.title,
    alternateName: config.site.brand,
    url: config.site.base_url,
    inLanguage: 'ja',
    description: config.site.description,
    publisher: person,
  },
];

if (blogpost && pubDate) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: meta_title || title || config.site.title,
    description: pageDescription,
    image: ogImage,
    datePublished: new Date(pubDate).toISOString(),
    dateModified: new Date(updatedDate || pubDate).toISOString(),
    author: person,
    publisher: person,
    inLanguage: 'ja',
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
  });
}
---

<!doctype html>
<html
  lang={config.site.lang}
  class="scroll-smooth"
  data-content-group={contentGroup}
  data-article-slug={blogpost ? slug : undefined}
  data-article-tags={blogpost && tags?.length ? tags.join(',') : undefined}
  data-published-date={blogpost && pubDate ? new Date(pubDate).toISOString().slice(0, 10) : undefined}
>
  <head>
    <meta name="google-site-verification" content="Zqz8CHfQz5W8Rbohpg9h4xL2ZIo6B1OpWM1dSLXhjxU" />
    <!-- favicon -->
    <link rel="icon" type="image/svg+xml" href={config.site.favicon} />
    <link rel="icon" type="image/png" href="/favicons/favicon-192x192.png" sizes="192x192" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FBFAF8" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0a" />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <!-- responsive meta -->
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />

    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="description" content={pageDescription} />
    <meta name="author" content={config.metadata.meta_author} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={blogpost ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={config.site.brand} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {blogpost && pubDate && <meta property="article:published_time" content={new Date(pubDate).toISOString()} />}
    {
      blogpost && (updatedDate || pubDate) && (
        <meta property="article:modified_time" content={new Date(updatedDate || pubDate).toISOString()} />
      )
    }
    {blogpost && <meta property="article:author" content={config.author.name} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={config.metadata.twitter} />
    <meta name="twitter:creator" content={config.metadata.twitter} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title={config.site.title} href={`${siteRoot}/rss.xml`} />

    <!-- Structured data -->
    {jsonLd.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}

    <script is:inline src="/registerSW.js"></script>
    <link rel="manifest" href="/manifest.webmanifest" />
    <ViewTransitions />

    <Analytics />

    <!-- Vercel Web Analytics。Hobbyプランではカスタムイベントは記録されず、PVと参照元のみ。 -->
    <script is:inline>
      window.va =
        window.va ||
        function () {
          (window.vaq = window.vaq || []).push(arguments);
        };
    </script>
    {import.meta.env.PROD && <script defer src="/_vercel/insights/script.js" />}
  </head>
  <body class="bg-paper transition-colors duration-300 dark:bg-gray-950">
    <Header />
    <main class="mx-auto max-w-2xl px-5 pt-14 sm:px-6 sm:pt-20">
      <slot />
    </main>
    <Footer />
    <script>
      type AnalyticsWindow = Window & {
        va?: CallableFunction;
        gtag?: CallableFunction;
      };
      const analyticsWindow = window as AnalyticsWindow;

      const sendEvent = (name: string, params: Record<string, string | number>) => {
        analyticsWindow.gtag?.('event', name, params);
      };

      // data-track の書式は "種別:名前:補足"（例: app:Koyori:home, app:Atode:App Store, social:x:post）。
      const bindTrackedLinks = () => {
        document.querySelectorAll<HTMLAnchorElement>('a[data-track]').forEach((link) => {
          if (link.dataset.trackingBound === 'true') return;
          link.dataset.trackingBound = 'true';
          link.addEventListener('click', () => {
            const target = link.dataset.track;
            if (!target) return;
            analyticsWindow.va?.('event', { name: 'outbound_click', data: { target } });
            sendEvent('outbound_click', {
              link_target: target,
              link_url: link.href,
              link_location: location.pathname,
            });
            const [kind, name, detail] = target.split(':');
            if (kind === 'app') {
              sendEvent('app_store_click', {
                app_name: name ?? '',
                link_target: target,
                link_detail: detail ?? '',
                link_url: link.href,
              });
            }
          });
        });
      };

      // 記事本文のどこまで読まれたか。記事の長さに比例した位置に目印を置いて、見えたら送る。
      let readObserver: IntersectionObserver | undefined;
      let observedBody: HTMLElement | undefined;
      const READ_MARKS = [25, 50, 75, 100];
      const observeReading = () => {
        const slug = document.documentElement.dataset.articleSlug;
        const body = document.querySelector<HTMLElement>('article .prose');
        // 初回表示は直接呼び出しと astro:page-load の両方から来るので、同じ本文には一度だけ仕掛ける。
        if (!slug || !body || body === observedBody) return;
        observedBody = body;

        readObserver?.disconnect();
        const startedAt = Date.now();
        readObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const percent = Number((entry.target as HTMLElement).dataset.readMark);
            readObserver?.unobserve(entry.target);
            entry.target.remove();
            sendEvent('scroll_depth', { percent, article_slug: slug });
            if (percent === 100) {
              sendEvent('article_read_complete', {
                article_slug: slug,
                seconds_to_complete: Math.round((Date.now() - startedAt) / 1000),
              });
            }
          });
        });

        if (getComputedStyle(body).position === 'static') body.style.position = 'relative';
        READ_MARKS.forEach((percent) => {
          const mark = document.createElement('span');
          mark.dataset.readMark = String(percent);
          mark.setAttribute('aria-hidden', 'true');
          mark.style.cssText = `position:absolute;left:0;width:1px;height:1px;pointer-events:none;top:calc(${percent}% - 1px)`;
          body.appendChild(mark);
          readObserver?.observe(mark);
        });
      };

      const onPageLoad = () => {
        bindTrackedLinks();
        observeReading();
      };
      onPageLoad();
      document.addEventListener('astro:page-load', onPageLoad);
      document.addEventListener('astro:before-swap', () => readObserver?.disconnect());
    </script>
    <script>
      // This is a hack to get vite-plugin-pwa to generate a sw.js file.
      // Do not remove this script tag.
    </script>
  </body>
</html>
